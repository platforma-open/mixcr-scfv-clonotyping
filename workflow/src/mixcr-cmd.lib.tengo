// The exec shape of the planning command and of every planned MiXCR step.

exec := import("@platforma-sdk/workflow-tengo:exec")

PROGRESS_PREFIX := "[==PROGRESS==]"

// builder starts a MiXCR command: the MI_LICENSE secret and its debug switch, the progress
// prefix, and stdout saved with stderr merged in, so the log carries the command's failure text.
builder := func(mixcrSw) {
	return exec.builder().
		software(mixcrSw).
		secret("MI_LICENSE", "MI_LICENSE").
		env("MI_LICENSE_DEBUG", "MI_LICENSE_DEBUG").
		env("MI_PROGRESS_PREFIX", PROGRESS_PREFIX).
		printErrStreamToStdout().
		saveStdoutStream()
}

export {
	PROGRESS_PREFIX: PROGRESS_PREFIX,
	builder: builder
}

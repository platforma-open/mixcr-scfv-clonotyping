// Imports the QC report TSV that :export-report wrote from anonymized samples, with the
// anonymized sample ids in its sampleId column replaced by the original ones.

self := import("@platforma-sdk/workflow-tengo:tpl")
pt := import("@platforma-sdk/workflow-tengo:pt")
maps := import("@platforma-sdk/workflow-tengo:maps")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")

qcReportColumns := import(":qc-report-columns")

self.defineOutputs("qcReportTable")

self.awaitState("tsv", "ResourceReady")
self.awaitState("chainsWithData", "ResourceReady")
self.awaitState("mapping", "ResourceReady")

self.body(func(inputs) {
	// anonymized sample id -> original sample id
	mapping := inputs.mapping.getDataAsJson()
	chainsWithData := inputs.chainsWithData.getDataAsJson()

	sampleId := pt.col("sampleId")
	expr := sampleId
	if len(mapping) > 0 {
		expr = undefined
		for anonymized in maps.getKeys(mapping) {
			cond := sampleId.eq(pt.lit(anonymized))
			then := pt.lit(mapping[anonymized])
			expr = is_undefined(expr) ? pt.when(cond).then(then) : expr.when(cond).then(then)
		}
		expr = expr.otherwise(sampleId)
	}

	wf := pt.workflow().inMediumQueue()
	df := wf.frame(inputs.tsv, { xsvType: "tsv", inferSchema: false })
	df.withColumns(expr.alias("sampleId")).save("result.tsv")
	tsv := wf.run().getFile("result.tsv")

	spec := qcReportColumns(inputs.hasUmi, inputs.sampleIdAxisSpec, chainsWithData).reportColumnsSpec

	return {
		qcReportTable: xsv.importFile(tsv, "tsv", spec)
	}
})
